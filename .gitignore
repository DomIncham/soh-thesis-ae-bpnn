__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
env/

# =========================
# OS / editor noise
# =========================
.DS_Store
Thumbs.db

# =========================
# Logs / temporary files
# =========================
*.log
tmp/
temp/
cache/
.cache/

# =========================
# Raw datasets and large archives
