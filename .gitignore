# =========================
NASA DataSet/
*.mat
*.zip

# =========================
# Model checkpoints / tensors / generated artifacts
# =========================
*.pt
*.pth
*.ckpt
*.onnx
outputs/
runs/
wandb/
mlruns/

# =========================
# LaTeX examples / scratch templates
# Keep out of the research Git repo for now because these are practice examples,
# not the final NTUST thesis source.
# =========================
examples/

# =========================
# Literature policy
# Ignore most collected papers first, but keep Dom-authored review materials.
# =========================
Journal Discovery/*
!Journal Discovery/literature review by dom/
!Journal Discovery/literature review by dom/**

# =========================
# LaTeX build artifacts
# Keep .tex/.bib sources, ignore generated build files.
# =========================
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.out
*.synctex.gz
*.toc
*.lof
*.lot

# =========================
# Exception (2026-09-23, R2 Steps 1-4): track the exact NASA FY08Q4 files so
# the EIS raw verification is reproducible from a plain clone. Public-domain
# NASA dataset, ~56 MB, stored once by Git. Other dataset folders, archives
# (.zip), and converted reports stay excluded.
# =========================
!NASA DataSet/
NASA DataSet/*
!NASA DataSet/1. BatteryAgingARC-FY08Q4/
!NASA DataSet/1. BatteryAgingARC-FY08Q4/**
Autoencoder/eis_verify/*.docx
